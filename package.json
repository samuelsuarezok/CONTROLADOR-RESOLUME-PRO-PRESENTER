{
  "name": "panel-cabina",
  "version": "1.2.0",
  "description": "Panel Cabina - botonera unificada para ProPresenter 6 y Resolume Arena 6",
  "type": "module",
  "private": true,
  "scripts": {
    "embeber": "bun scripts/embeber.ts",
    "dev": "bun scripts/embeber.ts && bun --watch src/main.ts",
    "start": "bun scripts/embeber.ts && bun src/main.ts",
    "build": "bun scripts/build.ts",
    "build:win": "bun scripts/build.ts win",
    "build:mac": "bun scripts/build.ts mac",
